<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        UWP/WinUI 2 overlay-scrollbar thickness (thin until hover) is controlled
        by the built-in ScrollBar template + visual states.

        UWP does not expose the WPF Track/Thumb types for easy retemplating.
        The supported approach is to change the ScrollBar's sizing properties.

        The style below makes horizontal scrollbars taller (constant layout size).
        Note: the OS may still render a thinner thumb until hover; fully disabling
        overlay behavior requires a complete theme-level template override.
    -->

    <Style x:Key="EE_HorizontalScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

</ResourceDictionary>
